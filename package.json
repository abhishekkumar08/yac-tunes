{
  "name": "yac-tunes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "seed": "node scripts/seed.js",
    "api": "node --watch server/index.js",
    "web": "vite --config web/vite.config.js",
    "dev": "concurrently -n api,web -c blue,green \"npm:api\" \"npm:web\"",
    "lint": "eslint web/src shared server scripts test e2e",
    "build": "vite build --config web/vite.config.js",
    "e2e": "playwright test",
    "fetch-pd": "node scripts/fetch-pd.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@kasumi/ui": "file:../kasumi",
    "fastify": "^5.12.7",
    "lucide-react": "^0.298.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@playwright/test": "1.61.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "concurrently": "^9.2.5",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.15.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.4"
  }
}
